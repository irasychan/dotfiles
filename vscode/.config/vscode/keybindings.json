[
  // Terminal: shift+enter sends escape before enter (for CLI tools)
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b\r"
    },
    "when": "terminalFocus"
  },
  // Toggle Vim mode
  {
    "key": "ctrl+shift+alt+.",
    "command": "toggleVim"
  }
]
