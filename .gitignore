.DS_Store
/.claude/
/.remember/
.vscode/
*.bak
*.swp
*~
tmux/.config/tmux/plugins/
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/lazyvim.json

# Secret-bearing file types (defense-in-depth deny-list).
# Nothing matching these is currently tracked; this is a safety net so a stray
# key, token, or env file dropped into the repo tree never gets staged.
*.asc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.env
.env.*
.netrc
.config/op/
